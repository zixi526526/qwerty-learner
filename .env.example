# Required in production. Generate one with: openssl rand -hex 32
FAMILY_COOKIE_SECRET=replace-with-a-random-secret

# Host directory holding the SQLite database, mounted into the container at /app/.data.
# The container runs as uid 1000, so this directory must be owned by uid 1000.
QL_DATA_PATH=./data

# Days an idle family session stays signed in before it has to be re-selected.
# FAMILY_SESSION_TTL_DAYS=30
